# Production Environment Configuration (PRD section 45)
# Copy to .env on your production server. NEVER commit real secrets to Git.

NODE_ENV=production
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas or VPS MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/personal_finance?retryWrites=true&w=majority

# Strong Random JWT Secret (generate with: openssl rand -base64 48)
JWT_SECRET=YOUR_SECURE_RANDOM_LONG_SECRET_KEY_HERE_MIN_32_CHARS

# Frontend / Public URL (Used for CORS in production)
FRONTEND_URL=https://yourdomain.com

# Enable secure cookie over HTTPS (PRD section 30 & 44)
COOKIE_SECURE=true
